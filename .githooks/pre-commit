#!/bin/bash
# Pre-commit gate. Install with: make setup-git-hooks
#
# Runs the SAME checks CI runs, scoped to what you actually staged, by delegating to
# `make verify` (scripts/verify-local.sh). There is deliberately ONE implementation of the
# suite mapping: upstream, the hook carried its own idea of "what changed" and its own lint
# invocations, the two drifted, and a whole module ended up linted by nothing for several
# releases. Do not reimplement the mapping here.
#
#   SKIP_VERIFY=1 git commit ...   escape hatch; CI is still the hard gate
#   FAST=0 git commit ...          also run govulncheck (skipped by default; ~1 min)
set -e

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED_FILES" ]; then
    echo "No staged files to check."
    exit 0
fi

# ── the CI suite, scoped to the staged change ────────────────────────────────
if [ "${SKIP_VERIFY:-0}" = "1" ]; then
    echo -e "${YELLOW}SKIP_VERIFY=1 - skipping local CI verification. CI remains the hard gate.${NC}"
else
    echo -e "${GREEN}Running the CI suite locally for the staged change...${NC}"
    if ! FAST="${FAST:-1}" make verify SUITES=--staged; then
        echo -e "${RED}✖ These checks would fail in CI too.${NC}"
        echo -e "${YELLOW}  Formatting and auto-fixable lint: run 'make lint' and re-stage.${NC}"
        echo -e "${YELLOW}  To commit anyway: SKIP_VERIFY=1 git commit ...${NC}"
        exit 1
    fi
fi

# ── commit-time concerns CI cannot do for you ────────────────────────────────

# Regenerate the docs index so `## Contents` tables and docs-coverage.json never drift, and
# re-stage the result. Hand-editing those tables is banned precisely because this runs.
if echo "$STAGED_FILES" | grep -q '^docs/' && command -v node >/dev/null 2>&1; then
    echo -e "${GREEN}Rebuilding docs index...${NC}"
    if node scripts/build-docs-index.js >/dev/null; then
        git add docs-coverage.json docs-index.json 2>/dev/null || true
        git add "$(git rev-parse --show-toplevel)/docs" 2>/dev/null || true
    else
        echo -e "${RED}✖ Docs frontmatter is invalid - see above.${NC}"
        exit 1
    fi
fi

# Map staged code changes to docs whose `covers` globs match, so documentation does not
# silently drift from the code. Advisory - doc updates are often a deliberate follow-up.
if command -v node >/dev/null 2>&1 && [ -f scripts/check-doc-coverage.js ]; then
    IMPACT=$(echo "$STAGED_FILES" | node scripts/check-doc-coverage.js 2>/dev/null) || true
    if [ -n "$IMPACT" ]; then
        echo -e "${YELLOW}${IMPACT}${NC}"
        echo -e "${YELLOW}If your change altered any behavior these docs describe, update them (not blocking).${NC}"
    fi
fi

# Conformance reminder. Not run here - it is minutes long and needs containers - but a format
# handler edit that ships without a conformance run is the defect class this project exists
# to avoid, so make it impossible to forget.
if echo "$STAGED_FILES" | grep -qE '^internal/(format|storage|proxy)/'; then
    echo -e "${YELLOW}⚠ You touched a format handler, storage, or the proxy cache.${NC}"
    echo -e "${YELLOW}  Run 'make conformance' before pushing - unit tests agree with your reading${NC}"
    echo -e "${YELLOW}  of the spec; only the real client disagrees.${NC}"
fi

echo -e "${GREEN}Pre-commit checks passed!${NC}"
exit 0
