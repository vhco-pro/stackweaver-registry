{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "worktree": {
    "baseRef": "fresh",
    "bgIsolation": "worktree"
  },
  "permissions": {
    "allow": [
      "Bash(awk:*)",
      "Bash(docker images:*)",
      "Bash(docker inspect:*)",
      "Bash(docker ps:*)",
      "Bash(find:*)",
      "Bash(gh api:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(gh repo:*)",
      "Bash(gh run:*)",
      "Bash(gh search:*)",
      "Bash(gh workflow:*)",
      "Bash(git add:*)",
      "Bash(git check-ignore:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(go build:*)",
      "Bash(go mod:*)",
      "Bash(go test:*)",
      "Bash(go version:*)",
      "Bash(go vet:*)",
      "Bash(gofumpt:*)",
      "Bash(golangci-lint:*)",
      "Bash(govulncheck:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(make build:*)",
      "Bash(make conformance:*)",
      "Bash(make docs:*)",
      "Bash(make lint:*)",
      "Bash(make test:*)",
      "Bash(make verify:*)",
      "Bash(node scripts/build-docs-index.js)",
      "Bash(node scripts/check-doc-coverage.js)",
      "Bash(sed *)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:conda.io)",
      "WebFetch(domain:docs.docker.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:docs.gitea.com)",
      "WebFetch(domain:docs.npmjs.com)",
      "WebFetch(domain:doc.rust-lang.org)",
      "WebFetch(domain:en.wikipedia.org)",
      "WebFetch(domain:forgejo.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:goharbor.io)",
      "WebFetch(domain:maven.apache.org)",
      "WebFetch(domain:packaging.python.org)",
      "WebFetch(domain:peps.python.org)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:pulpproject.org)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:specs.opencontainers.org)",
      "WebFetch(domain:web.archive.org)",
      "WebFetch(domain:wiki.debian.org)",
      "WebSearch"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && git config core.hooksPath .githooks 2>/dev/null || true",
            "statusMessage": "Activating repo git hooks"
          }
        ]
      }
    ]
  }
}
